# Purpose: keep all AEGIS C++ source mechanically consistent across editors and CI.

# Start from LLVM's established defaults, then record only deliberate AEGIS overrides.
BasedOnStyle: LLVM

# Keep diffs readable and use one unambiguous two-space indentation/alignment convention.
ColumnLimit: 100
IndentWidth: 2
DerivePointerAlignment: false
PointerAlignment: Left

# Preserve authored spacing after access-control labels so divider gaps survive formatting without
# forcing unrelated declarations to gain an empty line.
EmptyLineAfterAccessModifier: Leave

# Regroup and case-sensitively sort includes so dependency ordering is deterministic.
IncludeBlocks: Regroup
SortIncludes: CaseSensitive

# POSIX text files end in a newline; the formatter repairs a missing final newline.
InsertNewlineAtEOF: true
