{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "AEGIS_BUILD_BENCHMARKS": true,
        "AEGIS_WARNINGS_AS_ERRORS": true,
        "BUILD_TESTING": true,
        "CMAKE_CXX_EXTENSIONS": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "dev",
      "displayName": "Developer verification",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release benchmark build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Address and undefined behavior sanitizers",
      "inherits": "base",
      "cacheVariables": {
        "AEGIS_BUILD_BENCHMARKS": false,
        "AEGIS_ENABLE_ADDRESS_SANITIZER": true,
        "AEGIS_ENABLE_UNDEFINED_SANITIZER": true,
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "tsan",
      "displayName": "Thread sanitizer",
      "inherits": "base",
      "cacheVariables": {
        "AEGIS_BUILD_BENCHMARKS": false,
        "AEGIS_ENABLE_THREAD_SANITIZER": true,
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "format",
      "displayName": "Formatting checks",
      "inherits": "base",
      "cacheVariables": {
        "AEGIS_BUILD_BENCHMARKS": false,
        "BUILD_TESTING": false,
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "format",
      "configurePreset": "format"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "verify",
      "displayName": "Configure, build, and test",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    },
    {
      "name": "benchmark",
      "displayName": "Configure, build, and test the release profile",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "verify-asan-ubsan",
      "displayName": "Configure, build, and test with ASan and UBSan",
      "steps": [
        {
          "type": "configure",
          "name": "asan-ubsan"
        },
        {
          "type": "build",
          "name": "asan-ubsan"
        },
        {
          "type": "test",
          "name": "asan-ubsan"
        }
      ]
    },
    {
      "name": "verify-tsan",
      "displayName": "Configure, build, and test with TSan",
      "steps": [
        {
          "type": "configure",
          "name": "tsan"
        },
        {
          "type": "build",
          "name": "tsan"
        },
        {
          "type": "test",
          "name": "tsan"
        }
      ]
    }
  ]
}
