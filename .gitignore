# Purpose: keep compiler output, local tooling, and machine-specific files out of Git.
# Glob rules use `*` as a wildcard, while a trailing `/` ignores a whole directory.

# Ignore compiler-generated dependency records that are recreated with their object files.
*.d

# Ignore intermediate object files produced before linking.
*.slo
*.lo
*.o
*.obj

# Ignore compiler-specific precompiled-header artifacts.
*.gch
*.pch

# Ignore linker-generated incremental state.
*.ilk

# Ignore platform debugger-symbol databases.
*.pdb

# Ignore compiled dynamic libraries on Unix, macOS, and Windows.
*.so
*.dylib
*.dll
*.so.*

# Ignore Fortran module outputs if a development tool probes or generates them locally.
*.mod
*.smod

# Ignore compiled static libraries and libtool archives.
*.lai
*.la
*.a
*.lib

# Ignore executable and application-bundle outputs.
*.exe
*.out
*.app

# Ignore every supported local CMake build-directory naming convention.
build/
Build/
build-*/

# Ignore CMake and generator outputs that may also appear outside the normal build directories.
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Ignore editor, diagnostic, backup, and other temporary files.
*.tmp
*.log
*.bak
*.swp

# Ignore a local vcpkg dependency installation if a developer creates one for experimentation.
vcpkg_installed/

# Ignore split DWARF debug-information files.
*.dwo

# Ignore CTest output and generic local tool caches.
Testing/
.cache/

# Ignore local Python environments, Python caches, and generated benchmark measurements.
.venv/
.ruff_cache/
benchmark-results/
__pycache__/
*.pyc

# Ignore Finder metadata that carries no repository meaning.
.DS_Store
